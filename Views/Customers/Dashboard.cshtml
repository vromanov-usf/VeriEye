@{
    ViewData["Title"] = "Customer Portal";
}

<section class="premium-section customer-dashboard">

    <div class="dashboard-hero">
        <div>
            <p class="eyebrow">Customer Portal</p>
            <h1>Welcome to your VeriEye Customer Portal</h1>
            <p>
                Manage your VeriIdentity, linked accounts, MFA preferences,
                VeriTransactions, and bank permissions from one place.
            </p>
        </div>

        <div class="status-card">
            <span>Status</span>
            <h3>Identity Verified</h3>
            <p>Biometric profile active</p>

            <div class="status-row">
                <strong>Default Account</strong>
                <span>Checking •••• 8421</span>
            </div>

            <div class="status-row">
                <strong>Risk Level</strong>
                <span class="green">Low</span>
            </div>
        </div>
    </div>

    <div class="portal-grid">

        <a class="portal-card" asp-controller="Profile" asp-action="Index">
            <span>01</span>
            <h3>VeriIdentity</h3>
            <p>Manage your personal VeriEye identity profile.</p>
        </a>

        <a class="portal-card" asp-controller="LinkedAccounts" asp-action="Index">
            <span>02</span>
            <h3>Linked Accounts</h3>
            <p>View and manage connected bank accounts.</p>
        </a>

        <a class="portal-card" asp-controller="MFA" asp-action="Index">
            <span>03</span>
            <h3>MFA Settings</h3>
            <p>Add or update authentication preferences.</p>
        </a>

        <a class="portal-card" asp-controller="Customers" asp-action="Transactions">
            <span>04</span>
            <h3>VeriTransactions</h3>
            <p>Review secure VeriEye authentication events.</p>
        </a>

    </div>

    <div class="dashboard-lower-grid">

        <div class="insight-panel">
            <p class="eyebrow">Security Summary</p>
            <h3>VeriEye Activity Overview</h3>

            <div class="mini-row">
                <span>Last Login</span>
                <strong>Today, 9:42 AM</strong>
            </div>

            <div class="mini-row">
                <span>Verified Devices</span>
                <strong>2 Active</strong>
            </div>

            <div class="mini-row">
                <span>Pending Reviews</span>
                <strong>0</strong>
            </div>
        </div>

        <div class="insight-panel">
            <p class="eyebrow">Permissions</p>
            <h3>Bank Access Controls</h3>

            <div class="permission-pill">Chase Checking — Active</div>
            <div class="permission-pill">VeriEyePay — Enabled</div>
            <div class="permission-pill">Additional verification for high-risk transfers — On</div>
        </div>

    </div>

</section>