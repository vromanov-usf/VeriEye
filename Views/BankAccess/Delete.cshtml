@model VeriEye.Models.BankAccess

@{
    ViewData["Title"] = "Delete Bank Access";
}

<section class="container py-5">
    <div class="content-panel mx-auto" style="max-width: 700px;">
        <h1 class="mb-4">Delete Bank Access</h1>

        <p>Are you sure you want to remove this bank access?</p>

        <dl class="row">
            <dt class="col-sm-4">Institution</dt>
            <dd class="col-sm-8">@Model.InstitutionName</dd>

            <dt class="col-sm-4">Access Level</dt>
            <dd class="col-sm-8">@Model.AccessLevel</dd>

            <dt class="col-sm-4">Active</dt>
            <dd class="col-sm-8">@Model.IsActive</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input asp-for="BankAccessId" type="hidden" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-soft">Cancel</a>
        </form>
    </div>
</section>