@model List<VeriEye.Models.UserProfile>

@{
    ViewData["Title"] = "My VeriIdentity";
}

<section class="container py-5">

    <a asp-controller="Customers"
       asp-action="Dashboard"
       class="back-btn">
        ← Back to Portal
    </a>

    <div class="content-panel mx-auto" style="max-width:900px; padding:40px;">

        <span class="eyebrow">VERIIDENTITY</span>
        <h1 class="display-title mb-4">My VeriIdentity</h1>

        @foreach (var profile in Model)
        {
            <div style="background:#f7f7ff; border:1px solid #e3e3f5; border-radius:24px; padding:28px; margin-top:20px;">

                <div style="display:flex; align-items:center; gap:16px; margin-bottom:24px;">
                    <div style="width:58px; height:58px; border-radius:16px; background:#6c4cff; color:white; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:20px;">
                        VR
                    </div>

                    <div>
                        <div style="font-weight:700; color:#080637;">@profile.FullName</div>
                        <div style="color:#6b6b85;">@profile.Email</div>
                        <span style="display:inline-block; margin-top:6px; padding:4px 10px; border-radius:999px; background:#dff8e7; color:#14833b; font-size:12px; font-weight:700;">
                            KYC Approved
                        </span>
                    </div>
                </div>

                <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:14px;">

                    <div class="kyc-box">
                        <span>Date of Birth</span>
                        <strong>Jan 01, 2000</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Phone</span>
                        <strong>@profile.Phone</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Address</span>
                        <strong>@profile.Address</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Annual Income</span>
                        <strong>@profile.Income.ToString("C0")</strong>
                    </div>

                    <div class="kyc-box">
                        <span>SSN Status</span>
                        <strong>Verified</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Government ID</span>
                        <strong>Driver License</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Citizenship</span>
                        <strong>United States</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Risk Rating</span>
                        <strong>Low</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Occupation</span>
                        <strong>Professional</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Source of Funds</span>
                        <strong>Employment Income</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Last Verified</span>
                        <strong>Apr 25, 2026</strong>
                    </div>

                    <div class="kyc-box">
                        <span>Status</span>
                        <strong>@profile.Status</strong>
                    </div>

                </div>

                <div style="margin-top:24px; display:flex; gap:14px;">
                    <a asp-action="Edit"
                       asp-route-id="@profile.UserProfileId"
                       class="btn btn-glow">
                        Edit Identity
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@profile.UserProfileId"
                       class="btn btn-danger">
                        Delete
                    </a>
                </div>

            </div>
        }

    </div>
</section>

<style>
    .kyc-box {
        background: white;
        border: 1px solid #e4e4f1;
        border-radius: 14px;
        padding: 16px;
        min-height: 90px;
    }

        .kyc-box span {
            display: block;
            color: #67678a;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .kyc-box strong {
            color: #080637;
            font-size: 14px;
            font-weight: 800;
        }
</style>