@model VeriEye.Models.UserProfile

@{
    ViewData["Title"] = "Delete Profile";
}

<section class="container py-5">
    <div class="content-panel mx-auto" style="max-width: 700px;">
        <h1 class="mb-4">Delete Profile</h1>

        <p>Are you sure you want to delete this profile?</p>

        <dl class="row">
            <dt class="col-sm-4">Full Name</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@Model.Phone</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input asp-for="UserProfileId" type="hidden" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-soft">Cancel</a>
        </form>
    </div>
</section>