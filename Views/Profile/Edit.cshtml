@model VeriEye.Models.UserProfile

@{
    ViewData["Title"] = "Edit VeriIdentity";
}

<section class="container py-5">
    <div class="content-panel mx-auto" style="max-width: 700px;">
        <h1 class="mb-4">Edit VeriIdentity</h1>

        <form asp-action="Edit" method="post">
            <input asp-for="UserProfileId" type="hidden" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">Residential Address</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Income" class="form-label">Annual Income</label>
                <input asp-for="Income" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-glow">Update</button>
                <a asp-action="Index" class="btn btn-soft">Cancel</a>
            </div>
        </form>
    </div>
</section>