@{
    ViewData["Title"] = "Merchant Solutions";
}

<section id="merchant-solutions" class="premium-section audience-full reverse merchant-premium">
    <div class="audience-visual merchant-visual">
        <img src="~/images/merchant-checkout.png"
             asp-append-version="true"
             alt="Merchant checkout with VeriEye" />
    </div>

    <div class="audience-copy">
        <div class="section-heading">
            <p class="eyebrow">Merchant Solutions</p>
            <h2>VeriEye for Merchants.</h2>
            <p>
                VeriEye helps merchants reduce fraud, chargebacks, and checkout friction
                while improving customer trust.
            </p>
        </div>

        <div class="solution-grid">
            <div class="solution-card">
                <span>01</span>
                <h3>Reduces Chargebacks</h3>
                <p>Verified approvals create stronger proof of consent.</p>
            </div>

            <div class="solution-card">
                <span>02</span>
                <h3>Faster Checkout</h3>
                <p>No signature delays or failed tap transactions.</p>
            </div>

            <div class="solution-card">
                <span>03</span>
                <h3>Less Card Fraud</h3>
                <p>Fraudsters can steal cards, not iris identity.</p>
            </div>

            <div class="solution-card">
                <span>04</span>
                <h3>Higher Conversion</h3>
                <p>Less friction means more completed purchases.</p>
            </div>
        </div>
    </div>
</section>