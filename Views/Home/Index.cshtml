@{
    ViewData["Title"] = "Home";
}

<section id="home" class="verieye-hero">
    <div class="hero-copy">
        <p class="eyebrow">Your Identity Is the Key.</p>

        <h1>
            VeriEye: <span>AI-Powered Iris Authentication</span>
            for Secure Payments
        </h1>

        <p class="hero-description">
            VeriEye is a biometric payment and identity platform that helps customers,
            merchants, and financial institutions reduce fraud exposure by verifying
            who is behind every transaction.
        </p>
        <div class="hero-actions">

            <a href="#what-is-verieye" class="btn-main">
                Explore VeriEye
            </a>

            <a asp-controller="Account"
               asp-action="Signup"
               class="secondary-btn">
                Sign Up
            </a>

        </div>

            </div>
        </div>
        </div>
    </div>

    <div class="hero-visual">
        <img src="~/images/hero-eye.png" asp-append-version="true" alt="VeriEye iris authentication scan" />
    </div>
</section>

<section id="what-is-verieye" class="premium-section split-section">

    <div class="section-heading">
        <p class="eyebrow">What is VeriEye?</p>

        <h2>
            VeriEye transforms iris recognition into a secure digital
            identity layer for payments.
        </h2>

        <p>
            Instead of relying on what someone knows, such as a password,
            or what someone has, such as a card or phone,
            VeriEye verifies the actual person behind the transaction.
        </p>

        <p>
            A user can authenticate by looking into a scanner or
            camera-enabled device. Within seconds, AI verifies identity,
            detects anomalies, and approves, steps up, or flags the transaction.
        </p>
    </div>

    <div class="identity-card">

        <div class="identity-row">
            <span>Traditional Identity Check</span>
            <strong>Passwords • Cards • PINs • One-Time Codes</strong>
        </div>

        <div class="identity-divider">↓</div>

        <div class="identity-row active">
            <span>VeriEye Authentication</span>
            <strong>Iris Biometrics + AI Fraud Intelligence</strong>
        </div>
    </div>
</section>

</section>

<section id="how-it-works" class="premium-section">
    <div class="section-heading">
        <p class="eyebrow">How It Works</p>
        <h2>One secure flow from enrollment to approval.</h2>
        <p>
            VeriEye combines biometric matching, AI-powered fraud analysis, and secure decisioning
            into one authentication experience.
        </p>
    </div>

    <div class="timeline-grid">
        <div class="timeline-card">
            <span>01</span>
            <h3>Enrollment</h3>
            <p>A client securely registers once through their bank or merchant partner. VeriEye converts an iris scan into a mathematical biometric template — not a stored photo.</p>
        </div>

        <div class="timeline-card">
            <span>02</span>
            <h3>Request to Authenticate</h3>
            <p>When logging in, making a payment, withdrawing cash, or approving a transfer, the user is prompted for iris verification.</p>
        </div>

        <div class="timeline-card">
            <span>03</span>
            <h3>Iris Match in Seconds</h3>
            <p>The camera captures the live iris pattern and compares it to the encrypted template with AI-powered matching.</p>
        </div>

        <div class="timeline-card dark-timeline-card">
            <span>04</span>
            <h3>Fraud Intelligence Layer</h3>
            <p>VeriEye reviews risk signals such as device recognition, location mismatch, transaction anomalies, unusual login time, and suspicious behavior.</p>
        </div>

        <div class="timeline-card decision-card">
            <span>05</span>
            <h3>Instant Decision</h3>
            <div class="decision-pill approved">Approved — verified identity + low fraud risk</div>
            <div class="decision-pill stepup">Step-Up Authentication — secondary confirmation</div>
            <div class="decision-pill blocked">Blocked / Flagged — suspicious activity detected</div>
        </div>

        <div class="timeline-card">
            <span>06</span>
            <h3>Secure Audit Trail</h3>
            <p>Banks and merchants receive a secure authentication event log for compliance, disputes, and fraud investigations.</p>
        </div>
    </div>
</section>

<section id="fraud-dashboard" class="fraud-crisis-section">
    <div class="fraud-copy">
        <p class="eyebrow light">FTC Consumer Sentinel Network Data</p>
        <h2>Fraud losses are exploding in the U.S.</h2>

        <p>
            The Federal Trade Commission reported that consumers lost more than $12.5 billion
            to fraud in 2024, up 25% year over year.
        </p>

        <p>
            VeriEye uses public fraud trend data to demonstrate why stronger identity
            authentication is needed in banking and point-of-sale payments.
        </p>
    </div>

    <div class="fraud-stat-grid">
        <div><h3 id="metricLosses">Loading</h3><p>Reported fraud losses in 2024</p></div>
        <div><h3>+25%</h3><p>Year-over-year increase</p></div>
        <div><h3 id="metricReports">Loading</h3><p>Fraud reports</p></div>
    </div>
</section>

<section class="dashboard-section">
    <div class="dashboard-grid">
        <div class="chart-card"><h3>Fraud Reports by Category</h3><canvas id="categoryChart"></canvas></div>
        <div class="chart-card"><h3>Consumer Losses by Year</h3><canvas id="lossChart"></canvas></div>
        <div class="chart-card"><h3>Identity Theft Risk Areas</h3><canvas id="identityChart"></canvas></div>

        <div class="chart-card insight-card">
            <h3>Why stronger authentication matters</h3>
            <p>Fraud is no longer occasional — it is industrialized. VeriEye gives banks, merchants, and clients a stronger identity layer before money moves.</p>
            <ul>
                <li>Less dependence on passwords and SMS codes</li>
                <li>Biometric confirmation for risky transfers</li>
                <li>Fraud-aware checkout and account access</li>
                <li>Secure audit trail for investigations</li>
            </ul>
        </div>
    </div>
</section>

<section id="personal" class="premium-section audience-full">
    <div class="audience-copy">
        <div class="section-heading">
            <p class="eyebrow">Personal</p>
            <h2>VeriEye for Clients.</h2>
            <p>
                VeriEye gives customers safer banking, faster payments, and stronger identity
                protection without passwords, PINs, or SMS codes.
            </p>
        </div>

        <div class="solution-grid">
            <div class="solution-card"><span>01</span><h3>Safer Banking</h3><p>No more stolen passwords or account takeovers through phishing.</p></div>
            <div class="solution-card"><span>02</span><h3>Faster Payments</h3><p>A glance becomes approval.</p></div>
            <div class="solution-card"><span>03</span><h3>Identity Protection</h3><p>Iris confirms the real customer behind the payment.</p></div>
            <div class="solution-card"><span>04</span><h3>Account Access</h3><p>Manage linked accounts and permissions securely.</p></div>
        </div>
    </div>

    <div class="audience-visual">
        <img src="~/images/client-banking.png" asp-append-version="true" alt="Client using secure digital banking" />
    </div>
</section>

<section id="merchant-solutions" class="premium-section audience-full reverse merchant-premium">
    <div class="audience-visual merchant-visual">
        <img src="~/images/merchant-checkout.png" asp-append-version="true" alt="Merchant checkout with VeriEye" />
    </div>

    <div class="audience-copy">
        <div class="section-heading">
            <p class="eyebrow">Merchant Solutions</p>
            <h2>VeriEye for Merchants.</h2>
            <p>
                VeriEye helps merchants reduce fraud, chargebacks, and checkout friction
                while improving customer trust.
            </p>
        </div>

        <div class="solution-grid">
            <div class="solution-card"><span>01</span><h3>Reduces Chargebacks</h3><p>Verified approvals create stronger proof of consent.</p></div>
            <div class="solution-card"><span>02</span><h3>Faster Checkout</h3><p>No signature delays or failed tap transactions.</p></div>
            <div class="solution-card"><span>03</span><h3>Less Card Fraud</h3><p>Fraudsters can steal cards, not iris identity.</p></div>
            <div class="solution-card"><span>04</span><h3>Higher Conversion</h3><p>Less friction means more completed purchases.</p></div>
        </div>
    </div>
</section>

<section id="financial-institutions" class="premium-section audience-full">
    <div class="audience-copy">
        <div class="section-heading">
            <p class="eyebrow">Financial Institutions</p>
            <h2>VeriEye for Financial Institutions.</h2>
            <p>
                VeriEye gives banks an advanced identity layer for KYC, onboarding,
                secure transfers, and fraud prevention.
            </p>
        </div>

        <div class="solution-grid">
            <div class="solution-card"><span>01</span><h3>Stronger KYC</h3><p>Confirms identity during onboarding.</p></div>
            <div class="solution-card"><span>02</span><h3>Lower Fraud Losses</h3><p>Stops impersonation and account takeover.</p></div>
            <div class="solution-card"><span>03</span><h3>High-Risk Controls</h3><p>Large transfers can require iris verification.</p></div>
            <div class="solution-card"><span>04</span><h3>AI Monitoring</h3><p>Behavioral risk signals add extra protection.</p></div>
        </div>
    </div>

    <div class="audience-visual">
        <img src="~/images/financial-institution.png" asp-append-version="true" alt="Banker using VeriEye for KYC" />
    </div>
</section>

<section class="final-cta">
    <p class="eyebrow light">The Future of Payments</p>
    <h2>Identity-first payments start with VeriEye.</h2>
    <p>A secure iris authentication layer for consumers, merchants, and financial institutions.</p>
    <a asp-controller="Account"
       asp-action="Login"
       class="hero-cta-btn">
        Access Customer Portal
    </a>
</section>
