@{
    ViewData["Title"] = "About Us";
}

<section class="container py-5">

    <div class="content-panel mx-auto" style="max-width:1100px; padding:48px;">

        <span class="eyebrow">ABOUT VERIEYE</span>
        <h1 class="display-title mb-3">Meet the Team Behind VeriEye</h1>

        <p class="text-muted mb-5" style="max-width:760px;">
            VeriEye was built as a secure biometric payment and identity verification platform designed to help
            customers, merchants, and financial institutions reduce fraud through AI-powered iris authentication.
        </p>

        <div class="team-grid">

            <div class="team-card">
                <img src="~/images/vic.png" asp-append-version="true" alt="Victoria Romanov" class="mx-auto d-block" />
                <h3>Victorita Romanov</h3>
                <p>Product Strategy / FinTech Research</p>
            </div>

            <div class="team-card">
                <img src="~/images/dina.png" asp-append-version="true" alt="Dina Belafqih" class="mx-auto d-block" />
                <h3>Dina Belafqih</h3>
                <p>UI/UX Design / Front-End Development</p>
            </div>

            <div class="team-card">
                <img src="~/images/gavrie.png" asp-append-version="true" alt="Gavrie Grant" class="mx-auto d-block" />
                <h3>Gavrie Grant</h3>
                <p>Back-End Development / MVC Architecture</p>
            </div>

        </div>

        <div class="technical-box mt-5">
            <h2>Technical Documentation</h2>

            <p>
                Our GitHub README explains the technical structure of VeriEye, including API endpoints,
                the updated ERD diagram, CRUD implementation, and key technical challenges.
            </p>

            <a href="https://github.com/vromanov-usf/VeriEye#readme"
               target="_blank"
               class="btn btn-glow mt-3">
                View GitHub README
            </a>
        </div>

    </div>

</section>

<style>
    .team-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
    }

    .team-card {
        background: #f8f8ff;
        border: 1px solid #e6e6f3;
        border-radius: 24px;
        padding: 28px;
        text-align: center;
        box-shadow: 0 18px 40px rgba(8, 6, 55, 0.06);
    }

    .team-card img {
        width: 170px;
        height: 170px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #ffffff;
        box-shadow: 0 12px 30px rgba(8, 6, 55, 0.12);
        margin-bottom: 20px;
    }

    .team-card h3 {
        color: #080637;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .team-card p {
        color: #646482;
        font-weight: 600;
        margin-bottom: 0;
    }

    .technical-box {
        background: linear-gradient(135deg, #13085f, #6c4cff);
        color: white;
        border-radius: 28px;
        padding: 36px;
        box-shadow: 0 24px 60px rgba(18, 8, 95, 0.22);
    }

    .technical-box h2 {
        font-weight: 900;
        margin-bottom: 12px;
    }

    .technical-box p {
        color: #e8e5ff;
        max-width: 800px;
    }

    @@media (max-width: 900px) {
        .team-grid {
            grid-template-columns: 1fr;
        }
    }
</style>