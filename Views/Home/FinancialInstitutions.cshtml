@{
    ViewData["Title"] = "Financial Institutions";
}

<section class="page-hero">
    <div class="container-fluid px-5">
        <p class="kicker">FOR BANKS & FINANCIAL INSTITUTIONS</p>
        <h1>Financial Institutions</h1>
        <p>
            VeriEye helps banks strengthen KYC, reduce fraud, and support secure customer authentication for high-risk activity.
        </p>
    </div>
</section>

<section class="container-fluid px-5 section-block">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="panel h-100">
                <div class="icon-badge">KYC</div>
                <h3>KYC Verification</h3>
                <p>Support onboarding, account maintenance, and customer identity verification with biometric authentication.</p>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="panel h-100">
                <div class="icon-badge">AML</div>
                <h3>High-Risk Review</h3>
                <p>Use step-up authentication before large transfers, suspicious activity, or sensitive account changes.</p>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="panel h-100">
                <div class="icon-badge">ID</div>
                <h3>Account Protection</h3>
                <p>Help prevent impersonation, account takeover, unauthorized access, and identity misuse.</p>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="panel h-100">
                <div class="icon-badge">API</div>
                <h3>Integration Ready</h3>
                <p>Future bank systems could connect to VeriEye for identity checks, payment authorization, and audit logs.</p>
            </div>
        </div>
    </div>
</section>

<section class="container-fluid px-5 section-block">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="panel h-100">
                <p class="kicker">BANKING USE CASES</p>
                <h2>Where VeriEye fits</h2>

                <div class="value-list">
                    <div><strong>New account opening:</strong> confirm customer identity during onboarding.</div>
                    <div><strong>Password reset:</strong> reduce social engineering risk during account recovery.</div>
                    <div><strong>Large transfers:</strong> require biometric approval before funds move.</div>
                    <div><strong>New payee setup:</strong> verify the user before adding external recipients.</div>
                    <div><strong>Cardless ATM:</strong> support secure access without a card or PIN-only workflow.</div>
                    <div><strong>Fraud investigation:</strong> review authentication logs connected to suspicious activity.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="panel dark-panel h-100">
                <p class="kicker">WHY BANKS CARE</p>
                <h2>Stronger identity reduces weak points</h2>
                <p>
                    Traditional authentication can be compromised through stolen credentials, phishing,
                    social engineering, SIM swapping, or reused passwords. VeriEye gives institutions a stronger
                    identity layer for moments when trust matters most.
                </p>

                <div class="timeline">
                    <div>
                        <span>1</span>
                        <h4>Customer requests high-risk action</h4>
                        <p>Examples include account changes, large payments, or new device login.</p>
                    </div>

                    <div>
                        <span>2</span>
                        <h4>Institution triggers VeriEye</h4>
                        <p>The bank requests a biometric identity verification check.</p>
                    </div>

                    <div>
                        <span>3</span>
                        <h4>Customer authenticates</h4>
                        <p>The customer confirms identity through VeriEye’s iris-based MFA workflow.</p>
                    </div>

                    <div>
                        <span>4</span>
                        <h4>Decision is logged</h4>
                        <p>The bank receives an approval, denial, or review signal for audit support.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>