@model VeriEye.Models.LinkedAccount

@{
    ViewData["Title"] = "Delete Linked Account";
}

<section class="container py-5">
    <div class="content-panel mx-auto" style="max-width:700px;">
        <h1 class="mb-4">Delete Linked Account</h1>

        <p>Are you sure you want to remove this linked account?</p>

        <dl class="row">
            <dt class="col-sm-4">Bank Name</dt>
            <dd class="col-sm-8">@Model.BankName</dd>

            <dt class="col-sm-4">Nickname</dt>
            <dd class="col-sm-8">@Model.AccountNickname</dd>

            <dt class="col-sm-4">Account Type</dt>
            <dd class="col-sm-8">@Model.AccountType</dd>

            <dt class="col-sm-4">Account Number</dt>
            <dd class="col-sm-8">@Model.MaskedAccountNumber</dd>

            <dt class="col-sm-4">Default Account</dt>
            <dd class="col-sm-8">@Model.IsDefault</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input asp-for="LinkedAccountId" type="hidden" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-soft">Cancel</a>
        </form>
    </div>
</section>