@model List<VeriEye.Models.LinkedAccount>

@{
    ViewData["Title"] = "Linked Accounts";
}

<section class="container py-5">
    <a asp-controller="Customers"
       asp-action="Dashboard"
       class="back-btn">
        ← Back to Portal
    </a>

    <div class="content-panel mx-auto" style="max-width:1100px;">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Linked Accounts</h1>

            <a asp-action="Create" class="btn btn-glow">
                Add Linked Account
            </a>
        </div>

        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Bank Name</th>
                    <th>Nickname</th>
                    <th>Account Type</th>
                    <th>Account Number</th>
                    <th>Routing Number</th>
                    <th>Default</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.BankName</td>
                        <td>@item.AccountNickname</td>
                        <td>@item.AccountType</td>
                        <td>@item.MaskedAccountNumber</td>
                        <td>@item.RoutingNumber</td>
                        <td>@item.IsDefault</td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.LinkedAccountId"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.LinkedAccountId"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</section>