@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section id="home" class="verieye-hero">
    <div class="hero-copy">
        <p class="eyebrow">Your Identity Is the Key.</p>

        <h1>
            VeriEye: <span>AI-Powered Iris Authentication</span>
            for Secure Payments
        </h1>

        <p class="hero-description">
            VeriEye is a biometric payment and identity platform that helps customers,
            merchants, and financial institutions reduce fraud exposure by verifying
            who is behind every transaction.
        </p>

        <div class="hero-actions">
            <a href="#what-is-verieye" class="btn-main">Explore VeriEye</a>
            <a href="#fraud-dashboard" class="btn-light">View Fraud Insights</a>
        </div>
    </div>

    <div class="hero-visual">
        <img src="/images/hero-eye.png" alt="VeriEye iris authentication scan" />
        <div class="scan-card scan-card-top">
            <span class="pulse-dot"></span>
            Live Iris Match
        </div>
        <div class="scan-card scan-card-bottom">
            AI Fraud Risk: Low
        </div>
    </div>
</section>

<!-- WHAT IS VERIEYE -->
<section id="what-is-verieye" class="premium-section split-section">
    <div>
        <p class="eyebrow">What is VeriEye?</p>

        <h2>VeriEye transforms iris recognition into a secure digital identity layer for payments.</h2>

        <p class="section-lead">
            Instead of relying on what someone knows, such as a password, or what someone has,
            such as a card or phone, VeriEye verifies the actual person behind the transaction.
        </p>

        <p>
            A user can authenticate by looking into a scanner or camera-enabled device.
            Within seconds, AI verifies identity, detects anomalies, and approves, steps up,
            or flags the transaction.
        </p>
    </div>

    <div class="identity-card">
        <div class="identity-row">
            <span>Traditional Authentication</span>
            <strong>Password • Card • Phone • SMS Code</strong>
        </div>

        <div class="identity-divider">↓</div>

        <div class="identity-row active">
            <span>VeriEye Authentication</span>
            <strong>Iris biometric + AI fraud intelligence</strong>
        </div>
    </div>
</section>

<!-- CAPABILITIES -->
<section class="capability-strip">
    <div>
        <span>01</span>
        <h3>Passwordless</h3>
        <p>Reduces dependency on stolen credentials.</p>
    </div>

    <div>
        <span>02</span>
        <h3>Cardless</h3>
        <p>Limits stolen card and account misuse.</p>
    </div>

    <div>
        <span>03</span>
        <h3>AI-Aware</h3>
        <p>Reviews behavioral and transaction signals.</p>
    </div>

    <div>
        <span>04</span>
        <h3>Audit-Ready</h3>
        <p>Creates secure authentication event logs.</p>
    </div>
</section>

<!-- HOW IT WORKS -->
<section id="how-it-works" class="premium-section">
    <div class="section-heading">
        <p class="eyebrow">How It Works</p>
        <h2>One secure flow from enrollment to approval.</h2>
        <p>
            VeriEye combines biometric matching, AI-powered fraud analysis, and secure decisioning
            into one authentication experience.
        </p>
    </div>

    <div class="timeline-grid">
        <div class="timeline-card">
            <span>01</span>
            <h3>Enrollment</h3>
            <p>
                A client securely registers once through their bank or merchant partner.
                VeriEye captures an encrypted iris scan and converts it into a mathematical
                biometric template — not a stored photo.
            </p>
        </div>

        <div class="timeline-card">
            <span>02</span>
            <h3>Request to Authenticate</h3>
            <p>
                When logging in, making a payment, withdrawing cash, or approving a transfer,
                the system prompts the user for iris verification.
            </p>
        </div>

        <div class="timeline-card">
            <span>03</span>
            <h3>Iris Match in Seconds</h3>
            <p>
                The camera captures the live iris pattern and compares it to the encrypted template
                with AI-powered matching technology.
            </p>
        </div>

        <div class="timeline-card dark-timeline-card">
            <span>04</span>
            <h3>Fraud Intelligence Layer</h3>
            <p>VeriEye reviews additional risk signals:</p>
            <ul>
                <li>Device recognition</li>
                <li>Location mismatch</li>
                <li>Transaction amount anomaly</li>
                <li>Unusual login time</li>
                <li>Suspicious behavior patterns</li>
            </ul>
        </div>

        <div class="timeline-card decision-card">
            <span>05</span>
            <h3>Instant Decision</h3>
            <div class="decision-pill approved">Approved — verified identity + low fraud risk</div>
            <div class="decision-pill stepup">Step-Up Authentication — secondary confirmation</div>
            <div class="decision-pill blocked">Blocked / Flagged — suspicious activity detected</div>
        </div>

        <div class="timeline-card">
            <span>06</span>
            <h3>Secure Audit Trail</h3>
            <p>
                Banks and merchants receive a secure authentication event log for compliance,
                disputes, and fraud investigations.
            </p>
        </div>
    </div>
</section>

<!-- FRAUD DASHBOARD -->
<section id="fraud-dashboard" class="fraud-crisis-section">
    <div class="fraud-copy">
        <p class="eyebrow light">FTC Consumer Sentinel Network Data</p>
        <h2>Fraud losses are exploding in the U.S.</h2>

        <p>
            The Federal Trade Commission reported that consumers lost more than $12.5 billion
            to fraud in 2024, up 25% year over year.
        </p>

        <p>
            VeriEye uses public fraud trend data to demonstrate why stronger identity
            authentication is needed in banking and point-of-sale payments.
        </p>
    </div>

    <div class="fraud-stat-grid">
        <div>
            <h3 id="metricLosses">Loading</h3>
            <p>Reported fraud losses in 2024</p>
        </div>

        <div>
            <h3>+25%</h3>
            <p>Year-over-year increase</p>
        </div>

        <div>
            <h3 id="metricReports">Loading</h3>
            <p>Fraud reports</p>
        </div>
    </div>
</section>

<section class="dashboard-section">
    <div class="dashboard-grid">
        <div class="chart-card">
            <h3>Fraud Reports by Category</h3>
            <canvas id="categoryChart"></canvas>
        </div>

        <div class="chart-card">
            <h3>Consumer Losses by Year</h3>
            <canvas id="lossChart"></canvas>
        </div>

        <div class="chart-card">
            <h3>Identity Theft Risk Areas</h3>
            <canvas id="identityChart"></canvas>
        </div>

        <div class="chart-card insight-card">
            <h3>Why stronger authentication matters</h3>
            <p>
                Fraud is no longer occasional — it is industrialized. VeriEye gives banks,
                merchants, and clients a stronger identity layer before money moves.
            </p>

            <ul>
                <li>Less dependence on passwords and SMS codes</li>
                <li>Biometric confirmation for risky transfers</li>
                <li>Fraud-aware checkout and account access</li>
                <li>Secure audit trail for investigations</li>
            </ul>
        </div>
    </div>
</section>

